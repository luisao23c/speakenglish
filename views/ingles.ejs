<% /* Maya Video Call v3 */ %>
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0b141a">
<title>Maya</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
<style>

:root{--bg:#0b141a;--panel:#1f2c34;--panel2:#2a3942;--panel3:#344750;--text:#e9edef;--muted:#8696a0;--green:#00a884;--green2:#06cf9c;--err:#ea4335;--warn:#ffd166}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden}
body{font-family:Inter,-apple-system,sans-serif;background:var(--bg);color:var(--text);height:100dvh;overflow:hidden}
.app{display:flex;flex-direction:column;height:100dvh;position:relative}

/* TOPBAR */
.topbar{display:flex;align-items:center;gap:8px;padding:10px 16px;z-index:5;background:rgba(11,20,26,.9);backdrop-filter:blur(10px);border-bottom:1px solid rgba(255,255,255,.05)}
.topbar .nm{font-size:15px;font-weight:700;flex:1}
.dot{width:8px;height:8px;border-radius:50%;background:var(--green2);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
.tb{background:var(--panel2);border:0;color:var(--muted);width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;transition:.15s}
.tb:hover{background:var(--panel3);color:var(--text)}
.tb.on{color:var(--warn);background:rgba(255,209,102,.15)}

/* XP BAR */
.xpbar{display:flex;align-items:center;gap:8px;padding:6px 16px;background:rgba(0,0,0,.3)}
.xpbar .lv{background:var(--green);color:#fff;font-weight:800;font-size:11px;padding:2px 8px;border-radius:10px}
.xpbar .xv{font-size:11px;color:var(--muted);flex:1}
.xpbar .prog{height:4px;background:var(--panel3);border-radius:2px;flex:3;overflow:hidden}
.xpbar .prog i{display:block;height:100%;background:linear-gradient(90deg,var(--green),var(--green2));border-radius:2px;transition:width .5s}

/* AVATAR AREA */
.az{flex:1;display:flex;align-items:center;justify-content:center;padding:10px 0}
.ac{position:relative;width:180px;height:180px}
.aglow{position:absolute;inset:-15px;border-radius:50%;background:radial-gradient(circle,rgba(0,168,132,.15) 0%,transparent 70%);opacity:0;transition:opacity .4s}
.ac.spk .aglow{opacity:1;animation:gp 2s ease-in-out infinite}
@keyframes gp{0%,100%{transform:scale(1);opacity:.6}50%{transform:scale(1.1);opacity:1}}
.aring{position:absolute;inset:-6px;border-radius:50%;border:2px solid transparent;transition:all .3s}
.ac.spk .aring{border-color:var(--green);box-shadow:0 0 30px rgba(0,168,132,.3)}
.abg{width:100%;height:100%;border-radius:50%;background:linear-gradient(145deg,#1a3c5e,#0d253a);display:flex;align-items:center;justify-content:center;overflow:hidden}
.ac.spk .abg{animation:bounce .5s ease-in-out infinite alternate}
@keyframes bounce{from{transform:translateY(0) scale(1)}to{transform:translateY(-4px) scale(1.02)}}
.abg svg{width:140px;height:140px}

/* LISTENING STATE */
.ac.lstn{animation:listening-pulse 1.5s ease-in-out infinite}
@keyframes listening-pulse{0%,100%{box-shadow:0 0 0 0 rgba(234,67,53,.3)}50%{box-shadow:0 0 0 12px rgba(234,67,53,0)}}
.ac.lstn .aring{border-color:var(--err);box-shadow:0 0 20px rgba(234,67,53,.3)}

/* PROCESSING STATE */
.ac.proc{animation:processing-pulse 1s ease-in-out infinite}
@keyframes processing-pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.03)}}

/* SUBTITLE BOX - PROMINENT */
.sbox{width:90%;max-width:480px;margin:0 auto 8px;min-height:48px;background:rgba(0,0,0,.6);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:14px 18px;font-size:15px;line-height:1.6;color:var(--text);text-align:center;max-height:130px;overflow-y:auto;white-space:pre-wrap;word-break:break-word;transition:all .3s}
.sbox:empty{opacity:0;min-height:0;padding:0;border:none}
.sbox .label{display:inline-block;font-size:10px;font-weight:700;color:var(--green2);background:rgba(0,168,132,.15);padding:1px 8px;border-radius:8px;margin-bottom:4px}
.sbox .lesson-tag{display:inline-block;font-size:10px;font-weight:600;color:var(--warn);background:rgba(255,209,102,.12);padding:1px 8px;border-radius:8px;margin-left:4px}

/* CORRECTION OVERLAY */
.corr-overlay{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,.85);backdrop-filter:blur(10px);border:1px solid rgba(255,209,102,.3);border-radius:16px;padding:16px 20px;max-width:400px;width:90%;z-index:15;text-align:center;font-size:14px;line-height:1.6;display:none}
.corr-overlay.show{display:block;animation:fadeIn .3s}
@keyframes fadeIn{from{opacity:0;transform:translate(-50%,-50%) scale(.95)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}
.corr-overlay .wrong{color:var(--err);text-decoration:line-through}
.corr-overlay .right{color:var(--green2)}
.corr-overlay .tip{color:var(--warn);font-size:12px;margin-top:6px}

/* BOTTOM AREA - MIC + TEXT + LEVEL PATH TOGETHER */
.bottom-area{padding:8px 16px 20px;display:flex;flex-direction:column;align-items:center;gap:8px;z-index:5}

/* Mic row: level path + mic + level path */
.mic-row{display:flex;align-items:center;justify-content:center;gap:12px;width:100%;max-width:480px}

/* Level path - compact, horizontal, next to mic */
.lpath{display:flex;align-items:center;gap:3px;overflow-x:auto;flex:1;justify-content:center;padding:4px 0;scrollbar-width:none}
.lpath::-webkit-scrollbar{display:none}
.ldot{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;flex-shrink:0;transition:all .3s;cursor:pointer}
.ldot.dn{background:var(--green);color:#fff}
.ldot.cu{background:var(--warn);color:#000;box-shadow:0 0 12px rgba(255,209,102,.5);transform:scale(1.15)}
.ldot.lk{background:var(--panel2);color:var(--muted);opacity:.5}
.ldot.exam{border:2px dashed var(--warn);background:transparent;color:var(--warn)}
.lline{flex-shrink:0;width:10px;height:2px;background:var(--panel3);border-radius:1px}
.lline.dn{background:var(--green)}

/* Mic button - center */
.mic-area{display:flex;flex-direction:column;align-items:center;gap:4px;flex-shrink:0}
.wv{display:none;align-items:flex-end;justify-content:center;gap:3px;height:24px}
.wv.on{display:flex}
.wv i{width:3px;background:var(--err);border-radius:2px;animation:wv2 .5s ease-in-out infinite}
.wv i:nth-child(1){animation-delay:0s}
.wv i:nth-child(2){animation-delay:.07s}
.wv i:nth-child(3){animation-delay:.14s}
.wv i:nth-child(4){animation-delay:.21s}
.wv i:nth-child(5){animation-delay:.28s}
@keyframes wv2{0%,100%{height:4px}50%{height:18px}}
.mbtn{width:64px;height:64px;border-radius:50%;border:3px solid var(--panel3);background:var(--panel2);color:var(--text);font-size:26px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;position:relative}
.mbtn:hover{background:var(--panel3);border-color:var(--green);transform:scale(1.05)}
.mbtn:active{transform:scale(.95)}
.mbtn.rec{background:var(--err);border-color:var(--err);color:#fff;animation:mg 1.2s infinite}
@keyframes mg{0%,100%{box-shadow:0 0 0 0 rgba(234,67,53,.5)}50%{box-shadow:0 0 0 14px rgba(234,67,53,0)}}
.mbtn.pro{background:var(--green);border-color:var(--green);color:#fff}
.ml{font-size:11px;color:var(--muted);transition:color .2s;min-height:16px}
.ml.rec{color:var(--err);font-weight:600}
.ml.pro{color:var(--green2);font-weight:600}
.ml.ok{color:var(--green2)}

/* Text input - bigger, more prominent */
.tinput{display:flex;gap:8px;width:100%;max-width:480px;align-items:center}
.tinput input{flex:1;padding:12px 16px;border-radius:24px;border:1px solid var(--panel3);background:var(--panel2);color:var(--text);font-size:15px;font-family:inherit;outline:none;transition:border-color .2s}
.tinput input:focus{border-color:var(--green);box-shadow:0 0 0 2px rgba(0,168,132,.15)}
.tinput input::placeholder{color:var(--muted)}
.tinput button{width:42px;height:42px;border-radius:50%;border:0;background:var(--green);color:#fff;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background .2s}
.tinput button:hover{background:var(--green2)}

/* Chat panel */
.cpanel{position:fixed;bottom:0;left:0;right:0;max-height:55vh;background:var(--panel);border-top:1px solid var(--panel2);border-radius:20px 20px 0 0;transform:translateY(100%);transition:transform .3s;z-index:10;display:flex;flex-direction:column;overflow:hidden}
.cpanel.op{transform:translateY(0)}
.chdr{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--panel2);cursor:pointer}
.chdr h3{font-size:13px;font-weight:600;color:var(--muted)}
.cscr{flex:1;overflow-y:auto;padding:10px 14px;display:flex;flex-direction:column;gap:5px}
.cfab{position:fixed;bottom:180px;right:16px;width:38px;height:38px;border-radius:50%;background:var(--panel2);border:0;color:var(--muted);font-size:16px;cursor:pointer;z-index:11;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(0,0,0,.3)}
.ccnt{position:absolute;top:-3px;right:-3px;background:var(--green);color:#fff;font-size:9px;width:16px;height:16px;border-radius:50%;display:none;align-items:center;justify-content:center;font-weight:700}
.crow{display:flex;flex-direction:column;max-width:85%}
.crow.me{align-self:flex-end;align-items:flex-end}
.crow.ai{align-self:flex-start;align-items:flex-start}
.cbub{padding:8px 12px;font-size:13px;line-height:1.5;white-space:pre-wrap;word-break:break-word;border-radius:12px}
.crow.ai .cbub{background:var(--panel2);border-bottom-left-radius:2px}
.crow.me .cbub{background:var(--green);color:#fff;border-bottom-right-radius:2px}
.cmeta{font-size:9px;color:var(--muted);margin-top:1px;padding:0 4px}

/* Name modal */
.mover{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:20;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px)}
.mover.h{display:none}
.mbox{background:var(--panel);border-radius:20px;padding:28px 24px;max-width:340px;width:90%;text-align:center}
.mbox h2{font-size:22px;margin-bottom:8px}
.mbox p{font-size:13px;color:var(--muted);margin-bottom:20px;line-height:1.5}
.mbox input{width:100%;padding:12px 16px;border-radius:12px;border:1px solid var(--panel3);background:var(--panel2);color:var(--text);font-size:15px;font-family:inherit;outline:none;text-align:center;margin-bottom:16px}
.mbox input:focus{border-color:var(--green)}
.mbox button{width:100%;padding:12px;border-radius:12px;border:0;background:var(--green);color:#fff;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit}
.mbox button:hover{background:var(--green2)}
.pills{display:flex;gap:8px;justify-content:center;margin-bottom:16px;flex-wrap:wrap}
.pill{padding:6px 14px;border-radius:20px;background:var(--panel2);border:1px solid var(--panel3);color:var(--text);font-size:12px;cursor:pointer;transition:.2s}
.pill.ac{border-color:var(--green);background:rgba(0,168,132,.15);color:var(--green2)}
.pill:hover{border-color:var(--green)}

/* Mic permission banner */
.perm-banner{position:fixed;top:50px;left:50%;transform:translateX(-50%);background:rgba(234,67,53,.9);color:#fff;padding:10px 20px;border-radius:12px;font-size:13px;z-index:15;display:none;text-align:center;max-width:90%}
.perm-banner.show{display:block}


/* Volume bars */
.vol-bars{display:none;align-items:flex-end;justify-content:center;gap:2px;height:32px;padding:0 4px}
.vol-bars.on{display:flex}
.vol-bars i{width:4px;border-radius:2px;background:var(--err);transition:height 0.08s ease;min-height:3px}
.vol-ok{display:none;align-items:center;gap:4px;padding:4px 10px;border-radius:12px;background:rgba(0,168,132,.1);font-size:11px;color:var(--green2);font-weight:600}
.vol-ok.show{display:flex}
.vol-ok .dot-v{width:6px;height:6px;border-radius:50%;background:var(--green2);animation:pulse 1s infinite}

</style>
</head>
<body>

<div class="app">
  <div class="topbar">
    <span class="nm" id="tN">Maya</span><span class="dot"></span>
    <button class="tb" id="bS" title="Maya habla">&#x1f50a;</button>
    <button class="tb on" id="bA" title="Auto-escuchar">&#x1f399;&#xfe0f;</button>
    <button class="tb" id="bC" title="Chat">&#x1f4ac;</button>
    <button class="tb" id="bR" title="Reiniciar">&#x1f504;</button>
    <button class="tb" id="bP" title="Perfiles">&#x1f464;</button>
  </div>
  <div class="xpbar">
    <span class="lv" id="lvlB">A0</span>
    <span class="xv" id="xpL">0 XP</span>
    <div class="prog"><i id="xpP" style="width:0%"></i></div>
  </div>
  <div class="az">
    <div class="ac" id="ac">
      <div class="aglow"></div><div class="aring"></div>
      <div class="abg"><svg viewBox="0 0 160 160">
        <circle cx="80" cy="78" r="52" fill="#ffd166"/>
        <circle cx="80" cy="70" r="22" fill="#fff7e0"/>
        <g><circle cx="68" cy="65" r="5.5" fill="#1a3c5e"/><circle cx="69.5" cy="63.5" r="1.8" fill="#fff"/></g>
        <g><circle cx="92" cy="65" r="5.5" fill="#1a3c5e"/><circle cx="93.5" cy="63.5" r="1.8" fill="#fff"/></g>
        <path d="M58 55 Q64 50 72 53" stroke="#1a3c5e" stroke-width="2.2" fill="none" stroke-linecap="round"/>
        <path d="M88 53 Q96 50 102 55" stroke="#1a3c5e" stroke-width="2.2" fill="none" stroke-linecap="round"/>
        <ellipse id="mo" cx="80" cy="88" rx="9" ry="3.5" fill="#ff8f6b" stroke="#e67255" stroke-width="1"/>
        <circle cx="56" cy="80" r="7" fill="#ffb3b3" opacity=".25"/>
        <circle cx="104" cy="80" r="7" fill="#ffb3b3" opacity=".25"/>
        <path d="M42 48 Q40 35 55 30 Q65 26 80 25 Q95 26 105 30 Q120 35 118 48 Q115 42 108 38 Q100 34 90 33 Q80 32 70 34 Q60 36 52 40 Q45 44 42 48z" fill="#1a3c5d" opacity=".9"/>
      </svg></div>
    </div>
  </div>
  <div class="sbox" id="sub"><span class="label">Maya</span><br><span id="sT"></span></div>
  <div class="bottom-area">
    <div class="mic-row">
      <div class="lpath" id="lP"></div>
      <div class="mic-area">
        <div class="wv" id="wv"><i></i><i></i><i></i><i></i><i></i></div>
        <button class="mbtn" id="mic">&#x1f399;&#xfe0f;</button>
        <div class="ml" id="mL">Toca para hablar</div>
        <div class="vol-bars" id="volB"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        <div class="vol-ok" id="volOk"><span class="dot-v"></span> Voz detectada</div>
      </div>
      <div class="lpath" id="lP2"></div>
    </div>
    <div class="tinput"><input type="text" id="tField" placeholder="Escribe tu respuesta..." maxlength="500" autocomplete="off"><button id="tSend">&#x27a4;</button></div>
  </div>
</div>
<div class="corr-overlay" id="corrO"></div>
<button class="cfab" id="cF">&#x1f4ac;<span class="ccnt" id="cC">0</span></button>
<div class="cpanel" id="cP"><div class="chdr" id="cH"><h3>Historial</h3><span>&#x25bc;</span></div><div class="cscr" id="cS"></div></div>
<div class="perm-banner" id="permB">Necesitamos permiso para tu microfono. &#x1f399;</div>
<div class="mover h" id="nM"><div class="mbox">
  <h2>Hey! Soy Maya</h2>
  <p>Como te llamas? Vamos a ser compas.</p>
  <input type="text" id="nI" placeholder="Tu nombre..." maxlength="30" autocomplete="off">
  <div class="pills" id="pL"></div>
  <button id="nB">Lets go!</button>
</div></div>
<script>
(function(){
var G=function(s){return document.getElementById(s)};
var sub=G("sub"),sT=G("sT"),micBtn=G("mic"),mL=G("mL");
var ac=G("ac"),wvEl=G("wv");
var cS=G("cS"),cP=G("cP"),cF=G("cF"),cC=G("cC");
var bS=G("bS"),bA=G("bA"),bC=G("bC"),bR=G("bR"),bP=G("bP");
var lvlB=G("lvlB"),xpL=G("xpL"),xpP=G("xpP");
var nM=G("nM"),nI=G("nI"),nB=G("nB"),pL=G("pL"),lP=G("lP"),lP2=G("lP2");
var tField=G("tField"),tSend=G("tSend"),corrO=G("corrO"),permB=G("permB");

var PK="maya_profiles",allP=JSON.parse(localStorage.getItem(PK)||"[]"),actId=localStorage.getItem("maya_active")||"";
var hist=[],me=null,cOpen=false,cCnt=0;
var autoSpeak=localStorage.getItem("maya_speak")!=="0";
var autoMic=false;
var freezing=false,pVoice=false,rec=null,listening=false,hText="";
var SR=window.SpeechRecognition||window.webkitSpeechRecognition;

// === Avatar states ===
function setSpk(on){if(on){ac.classList.add("spk");ac.classList.remove("lstn","proc");G("mo").setAttribute("ry","7")}else{ac.classList.remove("spk");G("mo").setAttribute("ry","3.5")}}
function setLstn(on){if(on){ac.classList.add("lstn");ac.classList.remove("spk","proc")}else{ac.classList.remove("lstn")}}
function setProc(on){if(on){ac.classList.add("proc");ac.classList.remove("spk","lstn")}else{ac.classList.remove("proc")}}

// === Subtitle ===
function setSub(t,tag){
  var label="<span class=\"label\">Maya</span>";
  if(tag)label+=" <span class=\"lesson-tag\">"+tag+"</span>";
  sT.textContent="";
  sub.innerHTML=label+"<br>"+String(t).substring(0,400);
}

// === Chat bubbles ===
function addBub(type,text){
  var row=document.createElement("div");row.className="crow "+type;
  var bub=document.createElement("div");bub.className="cbub";bub.textContent=text;row.appendChild(bub);
  var m=document.createElement("div");m.className="cmeta";
  m.textContent=(type==="me"?"Tu":"Maya")+" . "+new Date().toLocaleTimeString("es",{hour:"2-digit",minute:"2-digit"});
  row.appendChild(m);cS.appendChild(row);cS.scrollTop=cS.scrollHeight;
  if(!cOpen){cCnt++;cC.textContent=cCnt;cC.style.display="flex"}
}

// === XP ===
function renderXP(){
  
  lvlB.textContent=me.level||"A0";
  xpL.textContent=(me.xp||0)+" XP";
  var pct=me.pct||0;xpP.style.width=pct+"%";
}

// === Level path ===
function renderPath(){
  lP.innerHTML="";lP2.innerHTML="";
  var current=1;
  var lesson=me?me.lesson:"";if(lesson){var m=String(lesson).match(/(\d+)/);if(m)current=parseInt(m[1])||1}
  var total=220;
  // Show 3 dots on each side
  var start=Math.max(1,current-3);var end=Math.min(total,current+3);
  var allDots=[];
  for(var i=start;i<=end;i++){
    var d=document.createElement("div");
    var isCur=i===current;var isExam=[11,22,33,44,55,66,77,88,99,110,121,132,143,154,165,176,187,198,209,220].indexOf(i)>=0;
    d.className="ldot "+(isCur?"cu":isExam?"exam":"lk");
    d.textContent=i;
    if(isExam&&i!==current)d.className="ldot exam";
    allDots.push(d);
    if(i<end){var ln=document.createElement("div");ln.className="lline";allDots.push(ln)}
  }
  // Split dots: first half on left, second on right
  var mid=Math.ceil(allDots.length/2);
  for(var i=0;i<allDots.length;i++){
    (i<mid?lP:lP2).appendChild(allDots[i]);
  }
}

// === Fetch profile ===
function fetchMe(){
  if(!actId)return;
  fetch("/api/ingles/me?id="+encodeURIComponent(actId)).then(function(r){return r.json()}).then(function(d){
    if(d){me=d;renderXP();renderPath()}
  }).catch(function(){});
}

// === Voice ===
// === Voice selection with language detection ===
var _esVoices=[],_enVoices=[];
function loadVoices(){
  if(!("speechSynthesis" in window))return;
  var vs=speechSynthesis.getVoices();
  _esVoices=vs.filter(function(v){return/^es/i.test(v.lang)});
  _enVoices=vs.filter(function(v){return/^en/i.test(v.lang)});
}
if("speechSynthesis" in window){loadVoices();speechSynthesis.onvoiceschanged=loadVoices}

function isSpanish(text){
  // Check for Spanish markers: accent chars, common Spanish words
  var t=text.toLowerCase();
  if(/[áéíóúñ¿¡]/.test(text))return true;
  if(/\b(hola|como|estas|que|tal|bien|gracias|por|favor|pero|tambien|voy|eres|soy|tiene|tengo|puedes|puedo|aqui|ahi|luego|despues|entonces|porque|cuando|donde|quien|cual|cuanto|nada|todo|muy|mucho|poco|bueno|malo|grande|pequeno|nuevo|viejo|hoy|ayer|manana|ahora|siempre|nunca|aqui|alli|vamos|decir|hacer|ir|venir|dar|ver|saber|creer|querer|gustar|haber|ser|estar|tener|poder|poner|salir|seguir|pasar|llevar|dejar|quedar|volver|tomar|conocer|sentir|llevar|buscar|entrar|caer|perder|morir|vivir|comer|beber|trabajar|estudiar|hablar|escribir|leer|pensar|sentir|creer|explicar|practicar|aprender|enseñar|corregir|repetir|escuchar|mirar|preguntar|responder|recordar|olvidar|empezar|terminar|continuar|intentar|ayudar|enseñar|hablar|platicar|charlar|conversar| divertido|chiste|broma|jaja|jeje|jojo)/.test(t))return true;
  return false;
}

function pickVoice(lang){
  var pool=lang==="es"?_esVoices:_enVoices;
  if(!pool.length){
    // Fallback to all voices
    pool=speechSynthesis.getVoices().filter(function(v){return lang==="es"?/^es/.test(v.lang):/^en/.test(v.lang)});
  }
  if(!pool.length)return null;
  // Prefer Google/Microsoft natural voices
  var preferred=pool.filter(function(v){return/Google|Microsoft|Samantha|Paulina|Helena|Monica/.test(v.name)});
  return preferred[0]||pool[0]||null;
}

function speak(text){
  if(!("speechSynthesis" in window))return;
  speechSynthesis.cancel();
  var plain=String(text).replace(/[*_]+/g,"").replace(/\s+/g," ").trim();
  if(!plain)return;
  
  var lang=isSpanish(plain)?"es":"en";
  var u=new SpeechSynthesisUtterance(plain);
  u.lang=lang==="es"?"es-MX":"en-US";
  
  // Natural rate: slower for teaching, normal for conversation
  var wordCount=plain.split(" ").length;
  if(lang==="es"){
    u.rate=0.92;  // Spanish slightly slower for clarity
    u.pitch=1.05; // Slightly higher, more friendly
  }else{
    u.rate=0.85;  // English slower for learners
    u.pitch=1.0;  // Natural pitch
  }
  
  var v=pickVoice(lang);
  if(v){
    u.voice=v;
    u.lang=v.lang;  // Use the voice's actual language tag
  }
  
  setSpk(true);
  u.onend=function(){setSpk(false);if(autoMic&&!freezing)setTimeout(startMic,800)};
  u.onerror=function(){setSpk(false)};
  speechSynthesis.speak(u);
}

// === Microphone ===
function showPerm(){permB.classList.add("show");setTimeout(function(){permB.classList.remove("show")},5000)}
function startMic(){
  if(freezing)return;
  if(!SR){setSub("Tu navegador no soporta microfono. Usa Chrome o Edge.");return}
  speechSynthesis.cancel();setSpk(false);
  if(rec){try{rec.abort()}catch(e){}rec=null}
  rec=new SR();rec.lang="en-US";rec.continuous=false;rec.interimResults=true;rec.maxAlternatives=1;
  rec.onstart=function(){
    listening=true;hText="";
    micBtn.classList.add("rec");mL.classList.add("rec");
    mL.textContent="Escuchando...";wvEl.classList.add("on");
    sT.textContent="";setLstn(true);
  };
  rec.onresult=function(e){
    var fin="",inter="";
    for(var i=0;i<e.results.length;i++){
      var t=e.results[i][0].transcript;
      var conf=e.results[i][0].confidence;
      if(e.results[i].isFinal){if(conf>0.05)fin+=(fin?" ":"")+t}else{inter=t}
    }
    if(fin)hText=fin;
    if(inter)sT.textContent=inter;
    if(hText)sT.textContent=hText;
  };
  rec.onerror=function(e){
    listening=false;micBtn.classList.remove("rec");mL.classList.remove("rec");
    wvEl.classList.remove("on");setLstn(false);
    if(e.error==="not-allowed"){showPerm();mL.textContent="Permiso denegado"}
    else if(e.error==="no-speech"){mL.textContent="No detecte voz. Habla mas fuerte."}
    else{mL.textContent="Error: "+(e.error||"?")}
    setTimeout(function(){mL.textContent="Toca para hablar"},3000);
  };
  rec.onend=function(){
    listening=false;micBtn.classList.remove("rec");mL.classList.remove("rec");
    wvEl.classList.remove("on");setLstn(false);
    var heard=hText.trim();
    if(heard&&heard.length>2){
      pVoice=true;mL.textContent="Enviando...";mL.classList.add("ok");
      setTimeout(function(){mL.classList.remove("ok")},2000);
      sendMessage();
    }else{
      mL.textContent="No te escuche bien. Intenta de nuevo o escribe.";
      setTimeout(function(){mL.textContent="Toca para hablar"},2500);
    }
  };
  try{rec.start()}catch(e){setSub("No pude iniciar el microfono.");mL.textContent="Error al iniciar mic"}
}
function stopMic(){if(rec){try{rec.stop()}catch(e){}}}
micBtn.ontouchstart=function(e){e.preventDefault();listening?stopMic():startMic()};micBtn.onclick=function(){listening?stopMic():startMic()};

// === Send message ===
async function sendMessage(){
  var text=hText.trim()||sT.textContent.trim();
  var voice=pVoice;pVoice=false;
  if(!text||freezing)return;
  hist.push({role:"user",text:(voice?"[mic] ":"")+text});
  addBub("me",text);saveChat();
  freezing=true;sT.textContent="Pensando...";setProc(true);
  micBtn.classList.add("pro");mL.textContent="Maya esta pensando...";
  try{
    var msgs=hist.slice(-20).map(function(m){return{role:m.role==="user"?"user":"assistant",content:m.text}});
    var r=await fetch("/api/ingles/chat",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:actId,messages:msgs})});
    var j=await r.json();
    if(!r.ok)throw new Error(j.error||"Error");
    hist.push({role:"assistant",text:j.reply});addBub("ai",j.reply);saveChat();
    setSub(j.reply);
    if(autoSpeak)speak(j.reply);
    if(j.profile){me=Object.assign({},me,j.profile);renderXP();renderPath()}
    // Show correction overlay if present
    if(j.correction)showCorrection(j.correction);
  }catch(e){
    setSub("No pude responder. Intenta de nuevo.");hist.pop();saveChat();
  }finally{freezing=false;setProc(false);micBtn.classList.remove("pro");mL.textContent="Toca para hablar"}
}

function saveChat(){if(!actId)return;localStorage.setItem("maya_chat_"+actId,JSON.stringify(hist.slice(-50)))}

function showCorrection(c){
  corrO.innerHTML="<div class=\"wrong\">"+c.wrong+"</div><div style=\"margin:6px 0\">&#x2193;</div><div class=\"right\">"+c.right+"</div><div class=\"tip\">"+c.tip+"</div>";
  corrO.classList.add("show");
  setTimeout(function(){corrO.classList.remove("show")},8000);
}

// === Text input ===
tField.onkeydown=function(e){if(e.key==="Enter"&&!freezing)sendText()};
tSend.onclick=function(){if(!freezing)sendText()};
function sendText(){var t=tField.value.trim();if(!t)return;tField.value="";hText=t;pVoice=false;sendMessage()}

// === Profiles ===
function renderPills(){
  pL.innerHTML="";
  allP.forEach(function(p){
    var d=document.createElement("div");d.className="pill"+(p.id===actId?" ac":"");
    d.textContent=p.name;d.onclick=function(){switchP(p.id)};pL.appendChild(d);
  });
  var nb=document.createElement("div");nb.className="pill";nb.textContent="+ Nuevo";
  nb.onclick=function(){var n=prompt("Nombre del nuevo perfil:");if(n&&n.trim())createP(n.trim())};
  pL.appendChild(nb);
}
function createP(name){
  var id="p_"+Date.now().toString(36);
  allP.push({id:id,name:name});
  localStorage.setItem(PK,JSON.stringify(allP));
  switchP(id);
}
function switchP(id){
  actId=id;localStorage.setItem("maya_active",id);
  var p=allP.find(function(x){return x.id===id});
  if(p)G("tN").textContent="Maya + "+p.name;
  renderPills();loadChat();
}
function loadChat(){
  if(!actId){nM.classList.remove("h");return}
  nM.classList.add("h");
  hist=JSON.parse(localStorage.getItem("maya_chat_"+actId)||"[]");
  cS.innerHTML="";hist.forEach(function(m){addBub(m.role==="user"?"me":"ai",m.text)});
  var last=hist[hist.length-1];
  if(hist.length===0){welcome();return}if(last&&last.role==="assistant")setSub(last.text);
  fetchMe();renderPath();
}

// === Name modal ===
nB.onclick=function(){var n=nI.value.trim();if(!n)return;createP(n)};
nI.onkeydown=function(e){if(e.key==="Enter")nB.click()};
bP.onclick=function(){nM.classList.toggle("h");renderPills()};

// === Controls ===
bS.onclick=function(){autoSpeak=!autoSpeak;localStorage.setItem("maya_speak",autoSpeak?"1":"0");bS.classList.toggle("on",autoSpeak)};
bS.classList.toggle("on",autoSpeak);
bA.onclick=function(){autoMic=!autoMic;localStorage.setItem("maya_autom",autoMic?"1":"0");bA.classList.toggle("on",autoMic);if(autoMic&&!listening&&!freezing)startMic()};
bA.classList.toggle("on",autoMic);
bC.onclick=function(){cOpen=!cOpen;cP.classList.toggle("op",cOpen);if(cOpen){cCnt=0;cC.style.display="none"}};
G("cH").onclick=function(){cOpen=false;cP.classList.remove("op")};
bR.onclick=function(){
  if(hist.length&&!confirm("Reiniciar?"))return;
  speechSynthesis.cancel();setSpk(false);
  if(rec){try{rec.abort()}catch(e){}rec=null}
  listening=false;micBtn.classList.remove("rec");wvEl.classList.remove("on");
  hist=[];cS.innerHTML="";saveChat();welcome();
};

// === Welcome ===
function welcome(){
  var p=allP.find(function(x){return x.id===actId});
  var un=p?p.name:"amigo";
  var hi="Heyy "+un+"! Soy Maya. Vamos a practicar ingles juntos. Yo te voy ensenando cosas nuevas y tu vas aprendiendo sin darte cuenta. Empecemos simple: como estas hoy?";
  hist.push({role:"assistant",text:hi});addBub("ai",hi);setSub(hi);saveChat();
  if(autoSpeak&&localStorage.getItem("maya_spoken")){setTimeout(function(){speak(hi)},400);}else{localStorage.setItem("maya_spoken","1");}
}

// === Init ===
renderPills();
if(actId){switchP(actId)}else{nM.classList.remove("h")}

// Load voices
if("speechSynthesis" in window){speechSynthesis.onvoiceschanged=function(){};speechSynthesis.getVoices()}
})();
</script>
</body>
</html>